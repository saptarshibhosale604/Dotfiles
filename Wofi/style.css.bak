#window {
    background-color: rgba(30, 30, 46, 0.9);
    border: none;
    margin: 0;
    padding: 0;
}

#input {
    background-color: rgba(50, 50, 60, 0.85);
    color: white;
    padding: 10px;
    font-size: 14px;
}

#entry {
    background-color: rgba(40, 40, 50, 0.8);
    color: white;
    padding: 8px 12px;
}

#entry:selected {
    background-color: rgba(70, 70, 90, 0.9);
    color: #ffffff;
}

